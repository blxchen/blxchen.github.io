rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function ownsPublication(data) {
      return verified()
        && data.ownerUid == request.auth.uid
        && data.profileSlugs.size() == 1
        && data.profileSlugs[0] == "member-" + request.auth.uid;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /profiles/{uid} {
      allow read: if resource.data.status == "public"
        || (verified() && request.auth.uid == uid)
        || admin();
      allow create: if admin() || (verified()
        && request.auth.uid == uid
        && request.resource.data.ownerUid == uid
        && request.resource.data.email == request.auth.token.email);
      allow update: if admin() || (verified()
        && request.auth.uid == uid
        && resource.data.ownerUid == uid
        && request.resource.data.ownerUid == uid
        && request.resource.data.email == request.auth.token.email);
      allow delete: if admin() || (verified() && request.auth.uid == uid);
    }

    match /publications/{publicationId} {
      allow read: if resource.data.status == "published"
        || admin()
        || (verified() && resource.data.ownerUid == request.auth.uid);
      allow create: if admin() || ownsPublication(request.resource.data);
      allow update: if admin() || (ownsPublication(resource.data) && ownsPublication(request.resource.data));
      allow delete: if admin() || (verified() && resource.data.ownerUid == request.auth.uid);
    }
  }
}
