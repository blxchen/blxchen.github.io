rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function verified() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    match /papers/{uid}/{publicationId}/{fileName} {
      allow read: if admin()
        || firestore.get(/databases/(default)/documents/publications/$(publicationId)).data.status == "published";
      allow write: if (admin() || (verified() && request.auth.uid == uid))
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == "application/pdf";
    }

    match /profiles/{uid}/{fileName} {
      allow read: if admin()
        || (verified() && request.auth.uid == uid)
        || firestore.get(/databases/(default)/documents/profiles/$(uid)).data.status == "public";
      allow write: if (admin() || (verified() && request.auth.uid == uid))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches("image/(jpeg|png|webp)");
    }
  }
}
